#!/usr/bin/env python3
import subprocess
import sys


def run_command(command):
    """Executes a shell command and handles errors."""
    try:
        subprocess.run(command, shell=True, check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error executing command: {e}")
        sys.exit(e.returncode)


def print_usage():
    """Prints the script usage instructions."""
    print(f"Usage: {sys.argv[0]} {{build|run}}")
    sys.exit(1)


def main():
    # Check if an argument was provided
    if len(sys.argv) < 2:
        print_usage()

    action = sys.argv[1]

    if action == "build":
        # Build the image
        print("Building the Docker image...")
        run_command("docker build -t stemplayer -f dockerfile .")

    elif action == "run":
        # Run the container
        print("Running the Docker container...")
        run_command(
            "docker run -it --rm "
            "--name stemplayer "
            "-p 8000:8000 "
            "-v /tmp/store:/tmp/asep "
            "--gpus all "
            "stemplayer bash run.sh"
        )

    else:
        # Invalid argument
        print_usage()


if __name__ == "__main__":
    main()
